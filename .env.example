# Servidor — na Render o PORT vem da plataforma. Não fixe 43888 em produção.
PORT=43888
SESSION_SECRET=troque-esta-chave-em-producao

# Login do painel /admin — obrigatório. Sem isso o /admin recusa login.
# Defina no .env local (gitignorado) ou no Environment da Render. Não commite valores reais.
ADMIN_USER=
ADMIN_PASS=

# Cookie seguro (a Render já liga HTTPS; local deixe vazio)
COOKIE_SECURE=

# Persistência JSON. Na Render free o disco é efêmero (some no redeploy).
DATA_PATH=

# Google OAuth (obrigatório em produção para o mural)
# Crie um cliente OAuth em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:43888/auth/google/callback
# Na Render, se vazio, usa RENDER_EXTERNAL_URL/auth/google/callback

# Sem GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET o mural entra em MODO DEV:
# o atleta escolhe uma identidade da lista para postar localmente.
